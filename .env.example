# Copy to .env and insert your Beijing-region Bailian key. Do not commit .env.
DASHSCOPE_API_KEY=your-api-key
ITEACHING_MODE=live
ITEACHING_MODEL=qwen-plus
ITEACHING_MODEL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_WEBSOCKET_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ITEACHING_ASR_MODEL=paraformer-v2
ITEACHING_LOCAL_ASR_MODEL=paraformer-realtime-v2

# Worker integration: copy these into your existing .env; keep the real API key.
AI_BACKEND_URL=http://127.0.0.1:8000
# Set the same unique token in backend/.env. This is NOT the Aliyun key.
AI_SERVICE_TOKEN=
AI_WORKER_ID=aliyun-worker-01

AI_AUDIO_STORAGE=oss

OSS_BUCKET_NAME=your-bucket-name

OSS_REGION=cn-beijing

OSS_AUDIO_PREFIX=iteaching-temp/

OSS_ACCESS_KEY_ID=

OSS_ACCESS_KEY_SECRET=
