APP_NAME=AI Teaching Supervision System
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false

API_V1_PREFIX=/api/v1

HOST=127.0.0.1
PORT=8000

DATABASE_URL=sqlite:///./data/app.db

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500

# Set a strong password to create the first administrator on startup.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Shared secret for the independent AI worker. Replace before deployment.
AI_SERVICE_TOKEN=replace-with-a-long-random-service-token
TASK_LEASE_SECONDS=300
TASK_MAX_ATTEMPTS=3
CONSENT_VERSION=2026-01

LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
